# Endpoints opcionais. Sem eles, o app usa os servidores públicos.
# Para produção com muito uso, hospede OSRM e Photon próprios.
VITE_OSRM_URL=https://router.project-osrm.org
VITE_PHOTON_URL=https://photon.komoot.io
# Tiles do mapa (padrão: OpenStreetMap). Use um provedor próprio para tráfego alto.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Consulta de praças de pedágio (padrão: overpass-api.de, com reserva em overpass.kumi.systems)
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
